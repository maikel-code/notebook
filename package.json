{
  "name": "notebook-source-qa",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "predev": "node scripts/check-node-version.mjs",
    "build": "next build",
    "prebuild": "node scripts/check-node-version.mjs",
    "start": "next start",
    "prestart": "node scripts/check-node-version.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/check-node-version.mjs",
    "lint": "biome check .",
    "prelint": "node scripts/check-node-version.mjs",
    "format": "biome format --write .",
    "preformat": "node scripts/check-node-version.mjs",
    "test": "vitest run --config vitest.config.ts",
    "pretest": "node scripts/check-node-version.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:integration": "node scripts/check-node-version.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/check-node-version.mjs",
    "db:reset": "supabase db reset --local",
    "predb:reset": "node scripts/check-node-version.mjs",
    "eval": "tsx eval/run.ts",
    "preeval": "node scripts/check-node-version.mjs",
    "calibrate:retrieval": "tsx eval/calibrate-retrieval.ts",
    "precalibrate:retrieval": "node scripts/check-node-version.mjs",
    "perf": "tsx eval/performance.ts",
    "preperf": "node scripts/check-node-version.mjs",
    "worker:sweep": "tsx scripts/sweep.ts",
    "preworker:sweep": "node scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/openai": "^4.0.71",
    "@napi-rs/canvas": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.107",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
