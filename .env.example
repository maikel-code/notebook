NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
# anthropic (default) oder openai; OPENAI_API_KEY bleibt für Einbettungen erforderlich.
NOTEBOOK_CHAT_PROVIDER=anthropic
# Optional, z. B. claude-sonnet-4-20250514 oder gpt-4.1-mini.
NOTEBOOK_CHAT_MODEL=
JOB_TRIGGER_SECRET=replace-with-random-job-trigger-secret
